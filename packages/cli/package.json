{
  "name": "@gish_reloaded/agentmesh-cli",
  "version": "0.1.0",
  "description": "AgentMesh command line interface",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "agentmesh": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22.4"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test \"test/**/*.test.ts\""
  },
  "dependencies": {
    "@gish_reloaded/agentmesh-protocol": "0.1.0",
    "@gish_reloaded/agentmesh-sdk": "0.1.0",
    "commander": "^12.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GishReloaded/agent-mesh.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/GishReloaded/agent-mesh/issues"
  },
  "homepage": "https://github.com/GishReloaded/agent-mesh/tree/main/packages/cli#readme",
  "keywords": [
    "agentmesh",
    "ai-agents",
    "collaboration",
    "realtime",
    "websocket",
    "protocol"
  ]
}
