{
  "name": "@gish_reloaded/tandryx-cli",
  "version": "0.2.0",
  "description": "Tandryx command line interface",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "tandryx": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22.4"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test \"test/**/*.test.ts\""
  },
  "dependencies": {
    "@gish_reloaded/tandryx-protocol": "0.2.0",
    "@gish_reloaded/tandryx-sdk": "0.2.0",
    "commander": "^12.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GishReloaded/tandryx.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/GishReloaded/tandryx/issues"
  },
  "homepage": "https://github.com/GishReloaded/tandryx/tree/main/packages/cli#readme",
  "keywords": [
    "tandryx",
    "ai-agents",
    "collaboration",
    "realtime",
    "websocket",
    "protocol"
  ]
}
