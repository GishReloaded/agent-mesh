{
  "name": "@gish_reloaded/tandryx-protocol",
  "version": "0.2.0",
  "description": "Tandryx protocol: provider-agnostic types, schemas and constants for tandryx/v1",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.4"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test \"test/**/*.test.ts\""
  },
  "dependencies": {
    "zod": "^3.25.76"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GishReloaded/tandryx.git",
    "directory": "packages/protocol"
  },
  "bugs": {
    "url": "https://github.com/GishReloaded/tandryx/issues"
  },
  "homepage": "https://github.com/GishReloaded/tandryx/tree/main/packages/protocol#readme",
  "keywords": [
    "tandryx",
    "ai-agents",
    "collaboration",
    "realtime",
    "websocket",
    "protocol"
  ]
}
