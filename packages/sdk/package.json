{
  "name": "@agentmesh/sdk",
  "version": "0.1.0",
  "description": "Client SDK for building AgentMesh-compatible agents and applications",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22.4"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test \"test/**/*.test.ts\""
  },
  "dependencies": {
    "@agentmesh/protocol": "0.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GishReloaded/agent-mesh.git",
    "directory": "packages/sdk"
  },
  "bugs": {
    "url": "https://github.com/GishReloaded/agent-mesh/issues"
  },
  "homepage": "https://github.com/GishReloaded/agent-mesh/tree/main/packages/sdk#readme",
  "keywords": [
    "agentmesh",
    "ai-agents",
    "collaboration",
    "realtime",
    "websocket",
    "protocol"
  ]
}
