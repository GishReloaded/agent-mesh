{
  "name": "@agentmesh/server",
  "version": "0.1.0",
  "description": "AgentMesh collaboration server: REST API, realtime gateway and session event log",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "agentmesh-server": "./dist/index.js"
  },
  "files": [
    "dist",
    "src/db/migrations"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "migrate": "tsx src/db/migrate.ts up",
    "migrate:reset": "tsx src/db/migrate.ts reset",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test --test-concurrency=1 \"test/**/*.test.ts\""
  },
  "dependencies": {
    "@agentmesh/protocol": "0.1.0",
    "@aws-sdk/client-apigatewaymanagementapi": "^3.700.0",
    "@aws-sdk/client-s3": "^3.1115.0",
    "@fastify/aws-lambda": "^5.1.0",
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^13.0.0",
    "@fastify/rate-limit": "^10.2.1",
    "@fastify/static": "^8.0.3",
    "fastify": "^5.2.0",
    "jose": "^5.9.6",
    "kysely": "^0.27.5",
    "pg": "^8.13.1",
    "ulid": "^2.3.0",
    "ws": "^8.18.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.146",
    "@types/pg": "^8.11.10",
    "@types/ws": "^8.5.13"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GishReloaded/agent-mesh.git",
    "directory": "packages/server"
  },
  "bugs": {
    "url": "https://github.com/GishReloaded/agent-mesh/issues"
  },
  "homepage": "https://github.com/GishReloaded/agent-mesh/tree/main/packages/server#readme",
  "keywords": [
    "agentmesh",
    "ai-agents",
    "collaboration",
    "realtime",
    "websocket",
    "protocol"
  ]
}
