# AgentMesh configuration.
#
# Copy to .env and adjust, or just run `npm run setup` which generates this
# file with a random JWT_SECRET and creates the database.
#
# Never commit .env - it is listed in .gitignore.

# --- runtime ----------------------------------------------------------------

NODE_ENV=development
HOST=0.0.0.0
PORT=4000
LOG_LEVEL=info

# --- database ---------------------------------------------------------------

# PostgreSQL 14 or newer.
DATABASE_URL=postgres://agentmesh:agentmesh@localhost:5432/agentmesh
DATABASE_POOL_MAX=10
DATABASE_SSL=false

# Used only by `npm test`. This database is WIPED before every run, so it must
# be a throwaway; the test harness refuses any name without "test" in it.
TEST_DATABASE_URL=postgres://agentmesh:agentmesh@localhost:5432/agentmesh_test

# --- authentication ---------------------------------------------------------

# Signing key for access tokens. Required in production; generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it signs every user out.
JWT_SECRET=

# Seconds. Access tokens are short-lived by design; refresh tokens rotate.
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000

# Set to false to close sign-ups on a private deployment.
ALLOW_REGISTRATION=true

# --- network ----------------------------------------------------------------

# Base URL used to build invite links, and the origin the web client is served
# from. When the server serves the UI itself, these are the same address.
PUBLIC_URL=http://localhost:4000

# Comma-separated list of browser origins allowed to call the API.
# Must be explicit in production; "*" is rejected there.
CORS_ORIGINS=http://localhost:5173,http://localhost:4000

# Directory holding the built web client. Leave empty to auto-detect
# packages/web/dist, or set to "none" to run the API without a UI.
WEB_DIST=

# --- limits -----------------------------------------------------------------

RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW=1 minute
WS_RATE_LIMIT=20

# How many agent-authored messages may address other agents in a row before a
# human has to take a turn. Guards against two models looping on each other.
AGENT_CHAIN_LIMIT=3
